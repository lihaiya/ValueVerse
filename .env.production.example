APP_ENV=production
AUTH_SECRET=replace-with-at-least-32-random-bytes
API_KEY_ENCRYPTION_SECRET=replace-with-a-stable-random-secret-for-api-key-encryption
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
API_DOCS_ENABLED=false

POSTGRES_DB=value_wiki
POSTGRES_USER=value_wiki
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Bind persistent data to the server's data disk.
POSTGRES_DATA_DIR=/data/valueverse/postgres
BACKEND_STORAGE_DIR=/data/valueverse/storage
# Set false only when the server can reach Hugging Face and should download missing models.
FASTEMBED_LOCAL_FILES_ONLY=true

# Use 127.0.0.1 when a host-level Nginx/Caddy terminates HTTPS.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80

CORS_ORIGINS=https://your-domain.example

ALLOWED_LLM_HOSTS=api.minimaxi.com,api.openai.com,ollama,host.docker.internal
ALLOWED_WEB_SEARCH_COMMANDS=uvx
ALLOWED_WEB_SEARCH_PACKAGES=minimax-coding-plan-mcp

MAX_UPLOAD_BYTES=209715200

# Tencent Enterprise Mail SMTP. Use the mailbox login and its SMTP/client authorization code.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=wiki@your-company.example
SMTP_PASSWORD=replace-with-tencent-enterprise-mail-smtp-password
SMTP_FROM_EMAIL=wiki@your-company.example
SMTP_FROM_NAME=valueverse
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=20
